<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              https://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>chaincode-packageId</id>

    <formats>
        <format>tar.gz</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>

        <!-- Include the metadata.json file -->
        <fileSet>
            <directory>.</directory>
            <includes>
                <include>metadata.json</include>
            </includes>
            <outputDirectory>.</outputDirectory>
        </fileSet>

        <!-- Include the code.tar.gz file we built in the previous step -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <includes>
                <include>code.tar.gz</include>
            </includes>
            <outputDirectory>.</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
