<?xml version='1.0' encoding='utf-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="DPP consistency — CONFLICT-RATE (100 INSTALL requests)" enabled="true">
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments" />
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath" />
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="100 simultaneous INSTALLs (independent plus contested slots)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads,100)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampUp,0)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="One actor/motor per request; designed duplicate slots in pairs" enabled="true">
          <stringProp name="filename">${__P(dataFile)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">actorId,componentId,eventId,operationId,hostId,dppId,slotId,groupId,contended</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
        <hashTree />
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON header" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree />
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Release all 100 clients simultaneously (one-shot burst)" enabled="true">
          <intProp name="groupSize">100</intProp>
          <longProp name="timeoutInMs">15000</longProp>
        </SyncTimer>
        <hashTree />
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="INSTALL — measured contention mix" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{"docType":"LIFECYCLE_EVENT","id":"${eventId}","operationId":"${operationId}","type":"INSTALL","actorId":"${actorId}","dppIds":["${dppId}"],"affectedAssetIds":["${hostId}","${componentId}"],"parentEventIds":[],"effectiveTime":"${__P(effectiveAt)}","issuedAt":"${__P(issuedAt)}","data":{"componentId":"${componentId}","hostId":"${hostId}","slotId":"${slotId}"}}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(port,8081)}</stringProp>
          <stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/api/events</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">120000</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Classify INSTALL accepted, semantic rejection, MVCC or unexpected" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">dpp-conflict-rate-classifier-v1</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
// The classifier only parses outcomes; Python validates which groups are
// permitted to have one exclusion and proves accepted state consistency.
vars.put('fabricStatus', '')
vars.put('semanticOutcome', '')
vars.put('validationCode', '')
vars.put('conflictCase', 'UNEXPECTED')
vars.put('fabricError', '')
vars.put('fabricStage', '')
vars.put('fabricMessage', '')
vars.put('eventId', vars.get('eventId') ?: '')
vars.put('groupId', vars.get('groupId') ?: '')
vars.put('slotId', vars.get('slotId') ?: '')
vars.put('contended', vars.get('contended') ?: '')
try {
    def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
    String status = (body.fabricStatus ?: '').toString()
    String semantic = (body.semanticOutcome ?: '').toString()
    String validation = (body.validationCode ?: '').toString()
    vars.put('fabricStatus', status)
    vars.put('semanticOutcome', semantic)
    vars.put('validationCode', validation)
    String fabricError = (body.error ?: '').toString()
    String fabricStage = (body.stage ?: '').toString()
    String fabricMessage = (body.message ?: '').toString().replaceAll(/[\r\n\t,]+/, ' ').take(450)
    vars.put('fabricError', fabricError)
    vars.put('fabricStage', fabricStage)
    vars.put('fabricMessage', fabricMessage)
    String code = prev.getResponseCode()
    boolean responseIdMatches = body.id?.toString() == vars.get('eventId')
    boolean accepted = code == '201' &amp;&amp; responseIdMatches &amp;&amp; status == 'VALID' &amp;&amp; semantic == 'ACCEPTED'
    boolean semanticRejected = code == '201' &amp;&amp; responseIdMatches &amp;&amp; status == 'VALID' &amp;&amp; semantic == 'REJECTED'
    boolean mvcc = code == '409' &amp;&amp; validation == 'MVCC_READ_CONFLICT'
    String caseName = accepted ? 'ACCEPTED' :
                      (semanticRejected ? 'SEMANTIC_REJECTED' :
                      (mvcc ? 'MVCC_READ_CONFLICT' : 'UNEXPECTED'))
    vars.put('conflictCase', caseName)
    if (!(accepted || semanticRejected || mvcc)) {
        prev.setSuccessful(false)
        prev.setResponseMessage('Unexpected contested INSTALL outcome: HTTP ' + code +
            '; status=' + status + '; semantic=' + semantic +
            '; validation=' + validation + '; id=' + (body.id ?: '') +
            '; error=' + fabricError + '; stage=' + fabricStage + '; message=' + fabricMessage)
    } else {
        // A 409/MVCC is a classified outcome, not automatically a PASS.
        // The group-wise Python check will enforce which losers are permitted.
        prev.setSuccessful(true)
    }
} catch (Exception ex) {
    prev.setSuccessful(false)
    prev.setResponseMessage('Cannot classify INSTALL response: ' + ex.getMessage())
}</stringProp>
          </JSR223PostProcessor>
          <hashTree />
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>